{
  "name": "tinyking",
  "version": "1.0.0",
  "description": "Tiny King game",
  "private": true,
  "scripts": {
    "test": "npx jest",
    "watch": "npx jest --watch",
    "build": "webpack --config webpack.prod.js",
    "start": "webpack serve --config webpack.dev.js --progress",
    "playtest": "node scripts/playtest.js"
  },
  "jest": {
    "moduleNameMapper": {
      "game/(.*)": "<rootDir>/src/game/$1",
      "^data/(.*)$": "<rootDir>/src/data/$1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chrismdp/tinyking.git"
  },
  "author": "Chris Parsons <chris@revelationgames.co>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/chrismdp/tinyking/issues"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "browsers": [
              "defaults"
            ]
          }
        }
      ],
      [
        "@babel/preset-react",
        {
          "development": false
        }
      ]
    ]
  },
  "homepage": "https://github.com/chrismdp/tinyking#readme",
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.5",
    "csv-loader": "^3.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "git-revision-webpack-plugin": "^5.0.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "html-webpack-root-plugin": "git+https://github.com/jeremy-hunter/html-webpack-root-plugin.git#patch-1",
    "jest": "^30.5.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.0",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "~1.2.36",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@popperjs/core": "^2.9.3",
    "@tweenjs/tween.js": "^18.6.4",
    "honeycomb-grid": "^3.1.8",
    "immer": "^9.0.6",
    "json-rules-engine-simplified": "^0.1.17",
    "mersenne-twister": "^1.1.0",
    "node-polyglot": "^2.4.0",
    "prop-types": "^15.8.1",
    "react-draggable": "^4.7.2",
    "react-polyglot": "^0.7.2",
    "react-router-dom": "^5.3.4",
    "regenerator-runtime": "^0.14.1",
    "simplex-noise": "^2.4.0",
    "three": "^0.186.1"
  },
  "overrides": {
    "babel-preset-current-node-syntax": {
      "@babel/core": "$@babel/core"
    }
  }
}
