{
  "name": "tinyking",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/worlds*"]
  },
  "r2_buckets": [
    { "binding": "WORLDS", "bucket_name": "tinyking-worlds" }
  ],
  "routes": [
    { "pattern": "tinyking.chrismdp.com", "custom_domain": true }
  ]
}
